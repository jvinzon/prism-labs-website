<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'PRISM Labs - Where Curiosity Becomes Capability' %></title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/img/prism-logo.svg">
  
  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/themes.css">
  <script src="/js/themes.js"></script>
</head>
<body class="theme-light">
  <!-- Navigation -->
  <nav class="navbar">
    <div class="container nav-container">
      <a href="/" class="nav-brand">
        <img src="/img/prism-logo.svg" alt="PRISM Labs" class="nav-logo">
        <span>PRISM Labs</span>
      </a>
      
      <button class="nav-toggle" id="navToggle">
        <span class="hamburger"></span>
      </button>
      
      <div class="nav-menu" id="navMenu">
        <a href="/" class="nav-link">Home</a>
        <a href="/about" class="nav-link">About</a>
        <a href="/showcase" class="nav-link">Showcase</a>
        <a href="/blog" class="nav-link">Blog</a>
        
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- Logged In -->
          <a href="/members/dashboard" class="nav-link">Dashboard</a>
          <a href="/members/resources" class="nav-link">Resources</a>
          <a href="/members/gamification/leaderboard" class="nav-link btn-accent">Leaderboard</a>
          <a href="/members/auth/logout" class="nav-link">Logout</a>
        <% } else { %>
          <!-- Logged Out -->
          <a href="/members/login" class="nav-link btn-primary" style="background: var(--accent-color); color: white; padding: 0.5rem 1rem; border-radius: 0.5rem;">
            🔐 Member Login
          </a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="main-content">
    <!-- Flash Messages -->
    <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
      <div class="flash-messages">
        <% messages.forEach(msg => { %>
          <div class="flash-message flash-<%= msg.type %>"><%= msg.message %></div>
        <% }) %>
      </div>
    <% } %>
    
    <%- body %>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-container">
      <!-- Centered Logo -->
      <div class="footer-logo-section">
        <img src="/img/prism-logo.svg" alt="PRISM Labs Logo" class="footer-logo">
        <p class="footer-tagline">Where Curiosity Becomes Capability</p>
      </div>
      
      <!-- Footer Grid -->
      <div class="footer-grid">
        <div class="footer-brand">
          <h3>PRISM Labs</h3>
          <p>Technology club at ASDAH exploring Programming, Refurbishing, Innovation, Systems, and Media.</p>
          <p class="footer-copyright">&copy; <%= new Date().getFullYear() %> ASDAH PRISM Labs</p>
        </div>
        
        <div class="footer-links">
          <h4>Quick Links</h4>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="/showcase">Showcase</a>
          <a href="/blog">Blog</a>
        </div>
        
        <div class="footer-links">
          <h4>Members</h4>
          <a href="/members/login">Member Login</a>
          <a href="/members/resources">Resources</a>
          <a href="/members/paths">Learning Paths</a>
          <a href="/members/gamification/leaderboard">Leaderboard</a>
        </div>
        
        <div class="footer-contact">
          <h4>Contact</h4>
          <p>ASDAH - Auckland Seventh-day Adventist High School</p>
          <p>Email: fine@asdah.school.nz</p>
        </div>
      </div>
      
      <!-- Theme Switcher -->
      <div class="footer-theme-switcher">
        <p>Choose Theme:</p>
        <div class="theme-buttons">
          <button class="theme-btn" data-theme="light" title="Light Theme">☀️ Light</button>
          <button class="theme-btn" data-theme="dark" title="Dark Theme">🌙 Dark</button>
          <button class="theme-btn" data-theme="prism" title="PRISM Theme">🌈 PRISM</button>
          <button class="theme-btn" data-theme="ocean" title="Ocean Theme">🌊 Ocean</button>
          <button class="theme-btn" data-theme="forest" title="Forest Theme">🌲 Forest</button>
        </div>
      </div>
      
      <!-- Discreet Admin Login -->
      <div class="admin-login-link" style="text-align: center; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
        <a href="/admin/login" style="color: var(--text-secondary); font-size: 0.75rem; text-decoration: none; opacity: 0.5;">
          Admin Login
        </a>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    // Mobile menu toggle
    document.getElementById('navToggle')?.addEventListener('click', () => {
      document.getElementById('navMenu').classList.toggle('active');
    });

    // Theme switcher
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const theme = btn.dataset.theme;
        document.body.className = `theme-${theme}`;
        localStorage.setItem('prism-theme', theme);
      });
    });

    // Load saved theme
    const savedTheme = localStorage.getItem('prism-theme') || 'light';
    document.body.className = `theme-${savedTheme}`;
  </script>
</body>
</html>
