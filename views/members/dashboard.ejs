<% layout = 'layouts/main' %>

<style>
.dashboard-container {
  max-width: 1400px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.welcome-section {
  background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
  color: white;
  padding: 3rem;
  border-radius: 1rem;
  margin-bottom: 2rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

.welcome-text h1 {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.welcome-text p {
  font-size: 1.125rem;
  opacity: 0.9;
}

.xp-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 1.5rem;
  border-radius: 1rem;
  text-align: center;
}

.xp-level {
  font-size: 3rem;
  font-weight: 800;
  display: block;
}

.xp-bar {
  height: 12px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 9999px;
  margin: 1rem 0;
  overflow: hidden;
}

.xp-fill {
  height: 100%;
  background: white;
  border-radius: 9999px;
  transition: width 0.5s;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: var(--bg-secondary);
  padding: 1.5rem;
  border-radius: 1rem;
  box-shadow: var(--shadow-md);
  text-align: center;
}

.stat-icon {
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
}

.stat-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--accent-color);
}

.stat-label {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.section-card {
  background: var(--bg-secondary);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.section-title {
  font-size: 1.5rem;
  font-weight: 800;
}

.team-card {
  background: linear-gradient(135deg, <%= user.team_color || '#3B82F6' %>, #1E40AF);
  color: white;
  padding: 2rem;
  border-radius: 1rem;
  margin-bottom: 1.5rem;
}

.team-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.team-name {
  font-size: 1.5rem;
  font-weight: 800;
}

.team-points {
  font-size: 2rem;
  font-weight: 800;
}

.resource-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.resource-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  background: var(--bg-primary);
  border-radius: 0.75rem;
  transition: transform 0.2s;
}

.resource-item:hover {
  transform: translateX(5px);
}

.resource-icon {
  width: 50px;
  height: 50px;
  border-radius: 0.5rem;
  background: var(--accent-color);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 1.5rem;
  flex-shrink: 0;
}

.resource-info {
  flex: 1;
}

.resource-title {
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.resource-meta {
  font-size: 0.875rem;
  color: var(--text-secondary);
}

.challenge-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.challenge-card {
  padding: 1rem;
  background: var(--bg-primary);
  border-radius: 0.75rem;
  border-left: 4px solid var(--accent-color);
}

.challenge-title {
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.challenge-reward {
  font-size: 0.875rem;
  color: var(--accent-color);
  font-weight: 700;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-top: 1rem;
}

.action-btn {
  padding: 1rem;
  border-radius: 0.75rem;
  border: 2px solid var(--border-color);
  background: var(--bg-primary);
  color: var(--text-primary);
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.action-btn:hover {
  border-color: var(--accent-color);
  background: var(--accent-color);
  color: white;
}

.action-icon {
  font-size: 2rem;
}
</style>

<div class="dashboard-container">
  <!-- Welcome Section -->
  <div class="welcome-section">
    <div class="welcome-text">
      <h1>Welcome back, <%= user.name %>! 👋</h1>
      <p><%= user.team_name || 'No team' %> Team • Level <%= user.level || 1 %> <%= user.level_name || 'Tīmatanga' %></p>
      <p><%= new Date().toLocaleDateString('en-NZ', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    </div>
    <div class="xp-card">
      <span class="xp-level"><%= user.total_xp || 0 %> XP</span>
      <div class="xp-bar">
        <div class="xp-fill" style="width: <%= (user.total_xp % 150) / 150 * 100 || 0 %>%;"></div>
      </div>
      <span><%= user.next_level_xp || 150 %> XP to next level</span>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="dashboard-grid">
    <div class="stat-card">
      <div class="stat-icon">🏆</div>
      <div class="stat-value"><%= user.total_xp || 0 %></div>
      <div class="stat-label">Total XP</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📚</div>
      <div class="stat-value"><%= user.resources_bookmarked || 0 %></div>
      <div class="stat-label">Resources Bookmarked</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">✅</div>
      <div class="stat-value"><%= user.challenges_completed || 0 %></div>
      <div class="stat-label">Challenges Completed</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">📅</div>
      <div class="stat-value"><%= user.attendance_count || 0 %></div>
      <div class="stat-label">Sessions Attended</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🏅</div>
      <div class="stat-value"><%= user.badges_earned || 0 %></div>
      <div class="stat-label">Badges Earned</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">👥</div>
      <div class="stat-value"><%= user.team_rank || '-' %></div>
      <div class="stat-label">Team Rank</div>
    </div>
  </div>

  <!-- Team Section -->
  <div class="section-card">
    <div class="section-header">
      <h2 class="section-title">🏆 Your Team</h2>
      <a href="/members/gamification/teams" class="btn-primary" style="padding: 0.75rem 1.5rem; text-decoration: none;">View All Teams</a>
    </div>
    <% if (user.team_name) { %>
      <div class="team-card">
        <div class="team-header">
          <div>
            <div class="team-name"><%= user.team_name %> Team</div>
            <div><%= user.team_description || 'Competing for PRISM glory!' %></div>
          </div>
          <div class="team-points"><%= user.team_points || 0 %> pts</div>
        </div>
        <div style="display: flex; gap: 2rem; margin-top: 1rem;">
          <div>
            <div style="opacity: 0.8; font-size: 0.875rem;">This Term</div>
            <div style="font-size: 1.5rem; font-weight: 800;"><%= user.team_term_points || 0 %></div>
          </div>
          <div>
            <div style="opacity: 0.8; font-size: 0.875rem;">All-Time</div>
            <div style="font-size: 1.5rem; font-weight: 800;"><%= user.team_total_points || 0 %></div>
          </div>
          <div>
            <div style="opacity: 0.8; font-size: 0.875rem;">Members</div>
            <div style="font-size: 1.5rem; font-weight: 800;"><%= user.team_members || 0 %></div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div style="text-align: center; padding: 2rem;">
        <h3>Join a Team to Start Earning Points!</h3>
        <p style="color: var(--text-secondary); margin: 1rem 0;">Teams compete each term for PRISM glory. Choose your team and start contributing!</p>
        <a href="/members/gamification/teams" class="btn-primary" style="padding: 1rem 2rem; text-decoration: none; display: inline-block;">Choose Your Team</a>
      </div>
    <% } %>
  </div>

  <!-- Active Challenges -->
  <div class="section-card">
    <div class="section-header">
      <h2 class="section-title">🎯 Active Challenges</h2>
      <a href="/members/gamification/challenges" class="btn-primary" style="padding: 0.75rem 1.5rem; text-decoration: none;">View All</a>
    </div>
    <div class="challenge-list">
      <% if (challenges && challenges.length > 0) { %>
        <% challenges.slice(0, 4).forEach(challenge => { %>
          <div class="challenge-card">
            <div class="challenge-title"><%= challenge.title %></div>
            <div style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 0.5rem;"><%= challenge.description.substring(0, 80) %>...</div>
            <div class="challenge-reward">⭐ <%= challenge.xp_reward %> XP</div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-secondary);">No active challenges. Check back soon!</p>
      <% } %>
    </div>
  </div>

  <!-- Recommended Resources -->
  <div class="section-card">
    <div class="section-header">
      <h2 class="section-title">📚 Recommended for You</h2>
      <a href="/members/resources" class="btn-primary" style="padding: 0.75rem 1.5rem; text-decoration: none;">Browse All</a>
    </div>
    <div class="resource-list">
      <% if (resources && resources.length > 0) { %>
        <% resources.slice(0, 3).forEach(resource => { %>
          <a href="/members/resources/<%= resource.id %>" style="text-decoration: none; color: inherit;">
            <div class="resource-item">
              <div class="resource-icon">📖</div>
              <div class="resource-info">
                <div class="resource-title"><%= resource.title %></div>
                <div class="resource-meta"><%= resource.category %> • <%= resource.difficulty %></div>
              </div>
              <div style="color: var(--accent-color); font-weight: 700;">Start Learning →</div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-secondary);">Browse our resource library to get personalized recommendations!</p>
      <% } %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="section-card">
    <h2 class="section-title">⚡ Quick Actions</h2>
    <div class="quick-actions">
      <a href="/members/bookings" class="action-btn">
        <span class="action-icon">📅</span>
        <span>Book Equipment</span>
      </a>
      <a href="/members/paths" class="action-btn">
        <span class="action-icon">🗺️</span>
        <span>Learning Paths</span>
      </a>
      <a href="/members/social/feed" class="action-btn">
        <span class="action-icon">💬</span>
        <span>Social Feed</span>
      </a>
      <a href="/members/gamification/shop" class="action-btn">
        <span class="action-icon">🏪</span>
        <span>PRISM Shop</span>
      </a>
    </div>
  </div>
</div>
