<% layout = 'layouts/main' %>

<style>
.resource-detail {
  max-width: 900px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.resource-header {
  background: var(--bg-secondary);
  padding: 2rem;
  border-radius: 1rem;
  margin-bottom: 2rem;
  border-left: 6px solid var(--accent-color);
}

.resource-title {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.resource-url {
  color: var(--accent-color);
  font-size: 1.125rem;
  margin-bottom: 1rem;
  display: block;
}

.resource-meta {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
}

.resource-section {
  background: var(--bg-secondary);
  padding: 2rem;
  border-radius: 1rem;
  margin-bottom: 2rem;
}

.related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1rem;
}
</style>

<div class="resource-detail">
  <div class="resource-header">
    <span class="resource-category"><%= resource.category %></span>
    <h1 class="resource-title"><%= resource.title %></h1>
    <a href="<%= resource.url %>" target="_blank" class="resource-url">🔗 <%= resource.url %></a>
    
    <div class="resource-meta">
      <span class="resource-badge <%= resource.is_free ? 'free' : 'paid' %>">
        <%= resource.is_free ? 'FREE' : 'PAID' %>
      </span>
      <span class="resource-badge <%= resource.difficulty %>">
        <%= resource.difficulty.charAt(0).toUpperCase() + resource.difficulty.slice(1) %>
      </span>
      <span>👁️ <%= resource.views_count %> views</span>
    </div>
    
    <a href="<%= resource.url %>" target="_blank" class="btn-resource btn-primary" style="display: inline-block; padding: 1rem 2rem; text-decoration: none;">
      🚀 Start Learning Now
    </a>
  </div>

  <div class="resource-section">
    <h2>About This Resource</h2>
    <p style="line-height: 1.8; color: var(--text-secondary);"><%= resource.description %></p>
    
    <% if (resource.tags) { %>
      <h3 style="margin-top: 2rem;">Tags</h3>
      <div class="resource-tags">
        <% JSON.parse(resource.tags).forEach(tag => { %>
          <span class="resource-tag">#<%= tag %></span>
        <% }) %>
      </div>
    <% } %>
  </div>

  <% if (related && related.length > 0) { %>
    <div class="resource-section">
      <h2>Related Resources</h2>
      <div class="related-grid">
        <% related.forEach(rel => { %>
          <a href="/members/resources/<%= rel.id %>" style="text-decoration: none; color: inherit;">
            <div class="resource-card" style="padding: 1rem; border-left: 3px solid var(--accent-color);">
              <h4 style="margin-bottom: 0.5rem;"><%= rel.title %></h4>
              <p style="font-size: 0.875rem; color: var(--text-secondary);"><%= rel.description.substring(0, 100) %>...</p>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>
