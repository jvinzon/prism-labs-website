<% layout = 'layouts/main' %>

<style>
.profile-container {
  max-width: 1000px;
  margin: 2rem auto;
  padding: 0 1rem;
}

.profile-header {
  background: var(--bg-secondary);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
  box-shadow: var(--shadow-md);
}

.profile-top {
  display: flex;
  gap: 2rem;
  align-items: center;
  margin-bottom: 2rem;
}

.profile-avatar {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent-color), var(--accent-hover));
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 3rem;
  font-weight: 800;
  border: 4px solid var(--border-color);
}

.profile-info h1 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.profile-username {
  color: var(--text-secondary);
  font-size: 1.125rem;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: linear-gradient(135deg, <%= user.badge_color %>, var(--accent-color));
  color: white;
  border-radius: 9999px;
  font-weight: 700;
  margin-top: 1rem;
}

.xp-section {
  background: var(--bg-primary);
  border-radius: 1rem;
  padding: 1.5rem;
  margin-top: 1.5rem;
}

.xp-bar-container {
  height: 24px;
  background: var(--border-color);
  border-radius: 9999px;
  overflow: hidden;
  margin: 1rem 0;
}

.xp-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-color), var(--accent-hover));
  border-radius: 9999px;
  transition: width 0.5s ease;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 1rem;
  color: white;
  font-weight: 700;
  font-size: 0.875rem;
}

.xp-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 1rem;
}

.xp-stat {
  text-align: center;
  padding: 1rem;
  background: var(--bg-secondary);
  border-radius: 0.75rem;
}

.xp-stat-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--accent-color);
}

.xp-stat-label {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.badges-section {
  background: var(--bg-secondary);
  border-radius: 1rem;
  padding: 2rem;
  margin-bottom: 2rem;
}

.badges-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 1rem;
}

.badge-card {
  background: var(--bg-primary);
  border-radius: 0.75rem;
  padding: 1rem;
  text-align: center;
  border: 2px solid var(--border-color);
}

.badge-icon {
  font-size: 3rem;
  margin-bottom: 0.5rem;
}

.badge-name {
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.badge-date {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.activity-section {
  background: var(--bg-secondary);
  border-radius: 1rem;
  padding: 2rem;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.activity-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: var(--bg-primary);
  border-radius: 0.75rem;
}

.activity-type {
  font-weight: 600;
}

.activity-xp {
  font-weight: 800;
  color: var(--accent-color);
}

.activity-xp.negative {
  color: #EF4444;
}
</style>

<div class="profile-container">
  <div class="profile-header">
    <div class="profile-top">
      <div class="profile-avatar">
        <%= user.name.charAt(0) %>
      </div>
      <div class="profile-info">
        <h1><%= user.name %></h1>
        <div class="profile-username">@<%= user.name.toLowerCase().replace(' ', '') %></div>
        <div class="level-badge">
          <span style="font-size: 1.5rem;"><%= user.badge_icon %></span>
          <span>Level <%= user.current_level %> - <%= user.level_name_te_reo %> (<%= user.level_name %>)</span>
        </div>
      </div>
    </div>

    <div class="xp-section">
      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 700;">Progress to Level <%= user.current_level + 1 %></span>
        <span style="font-weight: 700;"><%= user.level_progress %> / <%= user.next_level_xp %> XP</span>
      </div>
      <div class="xp-bar-container">
        <div class="xp-bar-fill" style="width: <%= (user.level_progress / user.next_level_xp) * 100 %>%;">
          <%= Math.round((user.level_progress / user.next_level_xp) * 100) %>%
        </div>
      </div>
      <div class="xp-stats">
        <div class="xp-stat">
          <div class="xp-stat-value"><%= user.total_xp.toLocaleString() %></div>
          <div class="xp-stat-label">Total XP</div>
        </div>
        <div class="xp-stat">
          <div class="xp-stat-value"><%= user.weekly_xp %></div>
          <div class="xp-stat-label">This Week</div>
        </div>
        <div class="xp-stat">
          <div class="xp-stat-value"><%= user.badgeCount || 0 %></div>
          <div class="xp-stat-label">Badges Earned</div>
        </div>
      </div>
    </div>
  </div>

  <div class="badges-section">
    <h2 style="margin-bottom: 1.5rem;">🏅 Badges & Achievements</h2>
    <div class="badges-grid">
      <% if (badges && badges.length > 0) { %>
        <% badges.forEach(badge => { %>
          <div class="badge-card">
            <div class="badge-icon"><%= badge.icon %></div>
            <div class="badge-name"><%= badge.name %></div>
            <div class="badge-date"><%= new Date(badge.earned_date).toLocaleDateString() %></div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-secondary);">No badges yet. Keep earning XP!</p>
      <% } %>
    </div>
  </div>

  <div class="activity-section">
    <h2 style="margin-bottom: 1.5rem;">📊 Recent XP Activity</h2>
    <div class="activity-list">
      <% if (activities && activities.length > 0) { %>
        <% activities.slice(0, 10).forEach(activity => { %>
          <div class="activity-item">
            <div>
              <div class="activity-type"><%= activity.activity_type %></div>
              <div style="font-size: 0.875rem; color: var(--text-secondary);"><%= new Date(activity.created_at).toLocaleDateString() %></div>
            </div>
            <div class="activity-xp <%= activity.xp_amount < 0 ? 'negative' : '' %>">
              <%= activity.xp_amount > 0 ? '+' : '' %><%= activity.xp_amount %> XP
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color: var(--text-secondary);">No activity yet.</p>
      <% } %>
    </div>
  </div>
</div>
