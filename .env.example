# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/prism-labs.db

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Microsoft 365 / Azure AD OAuth
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=jedidiah@asdah.school.nz

# GitHub Integration
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_ORG=jvinzon

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Microsoft Teams Webhook
TEAMS_WEBHOOK_URL=https://your-school.webhook.office.com/webhookb2/xxxxx

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Security
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN=7d
